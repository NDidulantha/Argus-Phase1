# Copy to .env for local development. Never commit .env.
ARGUS_ENV=dev
ARGUS_LOG_LEVEL=INFO
ARGUS_DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
# Generate real values with: openssl rand -hex 32
ARGUS_JWT_SECRET=dev-only-insecure-jwt-secret-0123456789abcdef
ARGUS_ADMIN_API_KEY=dev-admin-key-change-me
