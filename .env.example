# Copy to .env for local development. Never commit .env.
ARGUS_ENV=dev
ARGUS_LOG_LEVEL=INFO
ARGUS_DATABASE_URL=postgresql+asyncpg://argus:argus@localhost:5432/argus
# Generate real values with: openssl rand -hex 32
ARGUS_JWT_SECRET=dev-only-insecure-jwt-secret-0123456789abcdef
ARGUS_ADMIN_API_KEY=dev-admin-key-change-me
# Enrichment providers (leave empty to disable a provider)
ARGUS_VIRUSTOTAL_API_KEY=
ARGUS_ABUSEIPDB_API_KEY=
ARGUS_ENRICHMENT_CACHE_TTL_HOURS=24
# CTI (free): get one Auth-Key at https://auth.abuse.ch covering ThreatFox,
# MalwareBazaar, URLhaus. CISA KEV needs no key.
ARGUS_ABUSE_CH_AUTH_KEY=
ARGUS_CTI_CACHE_TTL_HOURS=24
